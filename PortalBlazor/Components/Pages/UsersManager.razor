@page "/usersmanager"
@using Microsoft.AspNetCore.Authorization
@using AutoMapper
@using PortalBlazor.Components.Modals.Users
@using PortalBlazor.Toasts
@using Resources.PortalResources
@using Users.Shared.Managers.Read
@using Users.Shared.Models.Roles
@using ViewModels.RazorPages.Users
@using Modal = BlazorBootstrap.Modal
@using SortDirection = BlazorBootstrap.SortDirection

@attribute [Authorize(Roles = nameof(UserRole.Administrator))]
<Toasts class="p-3" Messages="_messages" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight" />

<h3>@Resources.PortalResources.PortalResources.cUserManagement</h3>
<Button Color="ButtonColor.Primary" @onclick="OnShowModalClickForCreation"><i class="bi bi-person-plus"></i></Button> 
<hr/>
<Modal @ref="_modal" IsScrollable="true"/>
<Grid TItem="UserAdminViewModel"
      @ref="_grid"
      Class="table table-hover table-bordered table-striped"
      DataProvider="ReadData"
      AllowFiltering="true"
      AllowPaging="true"
      AllowSorting="true"
      Responsive="true"
      PageSizeSelectorVisible="true"
      PageSizeSelectorItems="@(new int[] { 5, 10, 20 })"
      OnRowClick="OnShowModalClick"
      AllowRowClick="true">
    
    <GridColumn TItem="UserAdminViewModel" HeaderText=@Resources.PortalResources.PortalResources.cName PropertyName="FirstName" SortString="FirstName" SortKeySelector="item => item.FirstName" FilterTextboxWidth="80">
        @context.FirstName
    </GridColumn>
    <GridColumn TItem="UserAdminViewModel" HeaderText=@Resources.PortalResources.PortalResources.cLastName PropertyName="LastName" SortString="LastName" SortKeySelector="item => item.LastName" FilterTextboxWidth="80">
        @context.LastName
    </GridColumn>
    <GridColumn TItem="UserAdminViewModel" HeaderText=@Resources.PortalResources.PortalResources.cUserName PropertyName="UserName" SortString="UserName" SortKeySelector="item => item.UserName" FilterTextboxWidth="80">
        @context.UserName
    </GridColumn>
    <GridColumn TItem="UserAdminViewModel" HeaderText=@Resources.PortalResources.PortalResources.cPhone PropertyName="Phone" SortString="Phone" Filterable="false">
        @context.PhoneNumber
    </GridColumn>
    <GridColumn TItem="UserAdminViewModel" HeaderText=@Resources.PortalResources.PortalResources.cEmail PropertyName="Email" SortString="Email" SortKeySelector="item => item.Email" FilterTextboxWidth="120">
        @context.Email
    </GridColumn>
    <GridColumn TItem="UserAdminViewModel" HeaderText=@Resources.PortalResources.PortalResources.cBirthDate PropertyName="BirthDate" SortString="BirthDate" SortKeySelector="item => item.BirthDate!" FilterTextboxWidth="80">
        @context.BirthDate
    </GridColumn>
</Grid>

@code {
    [Inject] private IUsersDownloader UsersDownloader { get; set; } = default!;
    [Inject] private IMapper Mapper { get; set; } = default!;
    [Inject] private ToastMessageCreationService ToastMessageCreationService { get; set; } = null!;
    [Inject] private ILogger<UsersManager> Logger { get; set; } = null!;
    private Grid<UserAdminViewModel> _grid = default!;
    private readonly List<ToastMessage> _messages = new();
    private Modal _modal = default!;

    private async Task<GridDataProviderResult<UserAdminViewModel>?> ReadData(GridDataProviderRequest<UserAdminViewModel> request)
    {
        try
        {
            StateHasChanged();
            string sortString = "";
            SortDirection sortDirection = SortDirection.None;

            if (request.Sorting is not null && request.Sorting.Any())
            {
                // Note: Multi column sorting is not supported at this moment
                sortString = request.Sorting.FirstOrDefault()!.SortString;
                sortDirection = request.Sorting.FirstOrDefault()!.SortDirection;
            }

            var users = await UsersDownloader.GetUsersPaged(request.PageNumber, request.PageSize, "", request.Filters);
            return await Task.FromResult(new GridDataProviderResult<UserAdminViewModel> { Data = users.Users.Select(Mapper.Map<UserAdminViewModel>), TotalCount = users.TotalCount });
        }
        catch (Exception ex)
        {
            Logger.Log(LogLevel.Critical, ex.Message);
        }

        return null;
    }
    
    private void ShowToast (string title, string message, ToastType toastType) 
        => _messages.Add(ToastMessageCreationService.CreateToastMessage(title, message, toastType));
    
    private void ShowFailToast () 
        => _messages.Add(ToastMessageCreationService.CreateUnknownErrorToastMessage());
    
    private async Task OnShowModalClick(GridRowEventArgs<UserAdminViewModel> args)
    {
        var parameters = new Dictionary<string, object>
        {
            { "User", args.Item },
            { "OnSuccessCallback", EventCallback.Factory.Create<Task>(this, OnSuccessEditUser) },
            { "OnFailCallBack", EventCallback.Factory.Create<Task>(this, OnFail) }
        };
        await _modal.ShowAsync<EditUserModal>(title: Resources.PortalResources.PortalResources.cUserEdit, parameters: parameters);
    }
    private async Task OnShowModalClickForCreation()
    {
        var parameters = new Dictionary<string, object>
        {
            { "OnSuccessCallback", EventCallback.Factory.Create<Task>(this, OnSuccessCreateUser) },
            { "OnFailCallBack", EventCallback.Factory.Create<Task>(this, OnFail) }
        };
        await _modal.ShowAsync<CreateUserModal>(title: @Resources.PortalResources.PortalResources.cCreateUser, parameters: parameters);
    }

    private async Task OnSuccessEditUser()
    {
        await _modal.HideAsync();
        await _grid.RefreshDataAsync();
        ShowToast(@PortalResources.cSuccess, PortalResources.cUserSuccessUpdated, ToastType.Success);
    }
    
    private async Task OnSuccessCreateUser()
    {
        await _modal.HideAsync();
        await _grid.RefreshDataAsync();
        ShowToast(@PortalResources.cSuccess, @Resources.PortalResources.PortalResources.cUserSuccessCreated, ToastType.Success);
    }
    private async Task OnFail()
    {
        await _modal.HideAsync();
        await _grid.RefreshDataAsync();
        ShowFailToast();
    }
}