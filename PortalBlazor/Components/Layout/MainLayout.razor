@using System.Globalization
@using global::Configuration.Shared.Culture
@using PortalBlazor.Components.Controls
@inherits LayoutComponentBase
@inject ISupportedLanguagesDownloader SupportedLanguagesDownloader

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <CultureSelector Items="GetSupportedCultures().GetAwaiter().GetResult()"/>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code
{
    private async Task<IEnumerable<CultureInfo>> GetSupportedCultures()=> await SupportedLanguagesDownloader.GetSupportedLanguages();
}
