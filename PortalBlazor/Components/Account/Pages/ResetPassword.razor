@page "/Account/ResetPassword"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Resources.PortalResources
@using Users.Shared.Managers.Edit
@using ViewModels.RazorPages.Users

@inject IdentityRedirectProcessor RedirectProcessor

<PageTitle>@PortalResources.cResetPassword</PageTitle>

<h1>@PortalResources.cResetPassword</h1>

<hr/>
<div class="row">
    <div class="col-md-4">
        <Alert Color="AlertColor.Danger" Dismissable="true" hidden="@string.IsNullOrEmpty(Message)">
            <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>
            @if (identityErrors is not null)
                @foreach (var msg in identityErrors)
                {
                    @msg
                    <br/>
                }
        </Alert>

        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <ValidationSummary class="text-danger" role="alert"/>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Please enter your password."/>
                <label for="password" class="form-label">@PortalResources.cPassword</label>
                <ValidationMessage For="() => Input.Password" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control"
                           autocomplete="new-password" aria-required="true"
                           placeholder="Please confirm your password."/>
                <label for="confirm-password" class="form-label">@PortalResources.cConfirmPassword</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@PortalResources.cResetButton <Icon
                    Name="IconName.Repeat"/>
            </button>
        </EditForm>
    </div>
</div>

@code {
    private IEnumerable<string>? identityErrors;

    [SupplyParameterFromForm] private ResetPasswordViewModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromQuery] private string? Email { get; set; }
    [Inject] private IUserPasswordEditor PasswordEditor { get; set; } = null!;

    private string? Message => identityErrors is null ? null : $"{string.Join("<br/>", identityErrors)}";

    protected override void OnInitialized()
    {
        if (Code is null || Email is null)
            RedirectProcessor.RedirectTo("Account/InvalidPasswordReset");

        Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
    }

    private async Task OnValidSubmitAsync()
    {
        var result = await PasswordEditor.ResetPasswordAsync(Email!, Code!, Input.Password);
        if (!result.Any())
            RedirectProcessor.RedirectTo("Account/ResetPasswordConfirmation");

        identityErrors = result;
    }
}