@page "/Account/ResetPasswordConfirmation"
@using Resources.PortalResources
<PageTitle>@PortalResources.cForgotPasswordConfirmation</PageTitle>

<h1>@PortalResources.cForgotPasswordConfirmation</h1>

<Alert Color="AlertColor.Success">
    <h4 class="alert-heading">@PortalResources.cSuccess</h4>
    <hr>
    <p class="mb-0">@PortalResources.cResetPasswordConfirmationMessage <a href="Account/Login">@PortalResources.cClickHereToLogin</a>.</p>
</Alert>
