@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Resources.PortalResources
@using Users.Shared.Exceptions
@using Users.Shared.Managers

@inject IdentityRedirectProcessor RedirectProcessor
@inject IUserEmailConfirmation UserEmailConfirmation;

<PageTitle>Confirm email</PageTitle>

<h1>Confirm email</h1>

<Alert Color="AlertColor.Success" Dismissable="true" hidden="@string.IsNullOrEmpty(_message)">
    <Icon Name="IconName.CheckCircleFill" class="me-2"></Icon> @_message </Alert>

<Alert Color="AlertColor.Danger" Dismissable="true" hidden="@string.IsNullOrEmpty(_errorMessage)">
    <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>  @_errorMessage </Alert>

@code {
    private string? _message;
    private string? _errorMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [Inject] ILogger<ConfirmEmail> Logger { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
            RedirectProcessor.RedirectTo("");
        try
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserEmailConfirmation.ConfirmEmailAsync(new Guid(UserId), code);
            _message = result ? PortalResources.cVerificationEmailSuccess : PortalResources.cVerificationEmailFail;
        }
        catch (UserNotFoundException)
        {
            _message = PortalResources.cVerificationEmailSuccess;
        }
        catch (Exception ex)
        {
            _errorMessage = PortalResources.cVerificationEmailFail;
            Logger.LogError(ex, "Error confirming email for user with id {UserId}", UserId);
        }
    }
}