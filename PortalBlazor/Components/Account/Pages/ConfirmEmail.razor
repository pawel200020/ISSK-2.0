@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Users.Shared.Managers
@using Users.Shared.Managers.Read

@inject IdentityRedirectProcessor RedirectProcessor
@inject IUsersDownloader UsersDownloader
@inject IUserEmailConfirmation UserEmailConfirmation;

<PageTitle>Confirm email</PageTitle>

<h1>Confirm email</h1>
<StatusMessage Message="@statusMessage"/>

@code {
    private string? statusMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectProcessor.RedirectTo("");
        }

        var user = await UsersDownloader.GetUserById(new Guid(UserId));
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"Error loading user with ID {UserId}";
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserEmailConfirmation.ConfirmEmailAsync(user, code);
            statusMessage = result? "Thank you for confirming your email." : "Error confirming your email.";
        }
    }

}