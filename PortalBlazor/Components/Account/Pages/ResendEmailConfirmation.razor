@page "/Account/ResendEmailConfirmation"
@using Resources.PortalResources
@using Users.Shared.Managers.Edit
@using ViewModels.RazorPages.Configuration

<PageTitle>@PortalResources.cResendConfirmationEmail</PageTitle>

<h1>@PortalResources.cResendConfirmationEmail</h1>
<h2>@PortalResources.cPleaseEnterEmail</h2>
<hr/>
<Alert Color="AlertColor.Success" Dismissable="true" hidden="@string.IsNullOrEmpty(_message)">
    <Icon Name="IconName.CheckCircleFill" class="me-2"></Icon> @_message </Alert>

<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="resend-email-confirmation" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com"/>
                <label for="email" class="form-label">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary"><Icon Name="IconName.Envelope"></Icon> @PortalResources.cResendConfirmation</button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private EmailModel Input { get; init; } = new();
    [SupplyParameterFromQuery] private string? Email { get; set; }
    [Inject] private IUserMetadataEditor UserMetadataEditor { get; set; } = null!;
    
    protected override async Task OnInitializedAsync()
    {
        if (Email is not null)
        {
            Input.Email = Email;
            await OnValidSubmitAsync();
        }
    }
    private string? _message;
    
    private async Task OnValidSubmitAsync()
    {
        await UserMetadataEditor.SendConfirmationLink(Input.Email);
        _message = PortalResources.cVerificationEmailSend;
    }
}