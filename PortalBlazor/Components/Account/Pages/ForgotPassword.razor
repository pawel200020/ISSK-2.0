@page "/Account/ForgotPassword"

@using Resources.PortalResources
@using Users.Shared.Password
@using ViewModels.RazorPages.Configuration

@inject IdentityRedirectProcessor RedirectProcessor

<PageTitle>@PortalResources.cForgotPasswordTitle</PageTitle>

<h1>@PortalResources.cForgotPasswordTitle</h1>
<h2>@PortalResources.cPleaseEnterEmail</h2>
<hr/>
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <ValidationSummary class="text-danger" role="alert"/>

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                <label for="email" class="form-label">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset password</button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private EmailModel Input { get; set; } = new();
    [Inject] private IUserResetPasswordEmailSender ResetPasswordEmailSender { get; set; } = null!;

    private async Task OnValidSubmitAsync()
    {
        await ResetPasswordEmailSender.SendResetPasswordEmail(Input.Email);
        RedirectProcessor.RedirectTo("Account/ForgotPasswordConfirmation");
    }
}