@page "/Account/Manage/Email"

@using Users.Shared.Managers
@using Users.Shared.Managers.Read
@using ViewModels.RazorPages.Configuration
@using Resources.PortalResources

@inject CurrentUserProvider UserProvider

<PageTitle>@PortalResources.cManageEmail</PageTitle>

<h3>@PortalResources.cManageEmail</h3>

<StatusMessage Message="@_message"/>
<div class="row">
    <div class="col-md-6">
        <form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form" method="post">
            <AntiforgeryToken/>
        </form>
        <EditForm Model="Input" FormName="change-email" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <ValidationSummary class="text-danger" role="alert"/>
            @if (_isEmailConfirmed)
            {
                <div class="form-floating mb-3 input-group">
                    <input type="text" value="@_currentEmail" class="form-control" placeholder="@PortalResources.cPleaseEnterEmail" disabled/>
                    <div class="input-group-append">
                        <span class="h-100 input-group-text text-success font-weight-bold">✓</span>
                    </div>
                    <label for="email" class="form-label">@PortalResources.cEmail</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input type="text" value="@_currentEmail" class="form-control" placeholder="@PortalResources.cPleaseEnterEmail" disabled/>
                    <label for="email" class="form-label">@PortalResources.cEmail</label>
                    <button type="submit" class="btn btn-link" form="send-verification-form">@PortalResources.cSendVerificationEmail</button>
                </div>
            }
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="@PortalResources.cPleaseEnterNewEmail"/>
                <label for="new-email" class="form-label">@PortalResources.cNewEmail</label>
                <ValidationMessage For="() => Input.Email" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@PortalResources.cChangeEmail</button>
        </EditForm>
    </div>
</div>

@code {
    private string? _message;
    private Guid _userId;
    private string? _currentEmail;
    private bool _isEmailConfirmed;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Inject] private IUserEmailConfirmation UserEmailConfirmation { get; set; } = null!;
    [Inject] private IUserMetadataGetter UserMetadataGetter { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "change-email")]
    private EmailModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _userId = UserProvider.GetRequiredUserGuid(HttpContext!);
        var userMetadata = await UserMetadataGetter.GetUserMetadataAsync(_userId);
        _currentEmail = userMetadata.Email;
        _isEmailConfirmed = userMetadata.IsEmailConfirmed;

        Input.Email = _currentEmail;
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.Email is null || Input.Email == _currentEmail)
        {
            _message = PortalResources.cEmailUnchanged;
            return;
        }

        await UserEmailConfirmation.SendConfirmationNewEmailAndGenerateToken(_userId, _currentEmail);
        _message = PortalResources.cConfirmationLinkSent;
    }

    private async Task OnSendEmailVerificationAsync()
    {
        if (_currentEmail is null)
            return;

        await UserEmailConfirmation.SendConfirmationCurrentEmailAndGenerateToken(_userId);
        _message = PortalResources.cVerificationEmailSent;
    }
}