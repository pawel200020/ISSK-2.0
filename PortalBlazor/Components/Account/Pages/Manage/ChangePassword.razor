@page "/Account/Manage/ChangePassword"
@using Microsoft.AspNetCore.Identity
@using PortalBlazor.Toasts
@using Resources.PortalResources
@using Users.Shared.Managers.Edit
@using Users.Shared.Models
@using ViewModels.RazorPages.Users

@inject IUserPasswordEditor UserPasswordEditor
@inject CurrentUserProvider CurrentUserProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectProcessor RedirectProcessor
@inject ILogger<ChangePassword> Logger

<PageTitle>@PortalResources.cChangePassword</PageTitle>

<h3>@PortalResources.cChangePassword</h3>
<Toasts class="p-3" Messages="_messages" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight"/>
<StatusMessage Message="@_message"/>
<div class="row">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@PortalResources.cOldPasswordPlaceholder" />
                <label for="old-password" class="form-label">@PortalResources.cOldPasswordLabel</label>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@PortalResources.cNewPasswordPlaceholder" />
                <label for="new-password" class="form-label">@PortalResources.cNewPasswordLabel</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@PortalResources.cConfirmPasswordPlaceholder" />
                <label for="confirm-password" class="form-label">@PortalResources.cConfirmPasswordLabel</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@PortalResources.cUpdatePassword</button>
        </EditForm>
    </div>
</div>

@code {
    private string? _message;
    private readonly List<ToastMessage> _messages = new();
    private ApplicationUser user = default!;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ChangePasswordViewModel Input { get; set; } = new();
    [Inject] private ToastMessageCreationService ToastMessageCreationService { get; set; } = null!;

    private async Task OnValidSubmitAsync()
    {
        try
        {
            var currentUserGuid = CurrentUserProvider.GetRequiredUserGuid(HttpContext);
            var errors = (await UserPasswordEditor.ChangePasswordAsync(currentUserGuid, Input.OldPassword, Input.NewPassword)).ToList();
            if (errors.Any())
            {
                _message = string.Join(Environment.NewLine, errors);
                return;
            }
        }
        catch (Exception ex)
        {
            _messages.Add(ToastMessageCreationService.CreateToastMessage(PortalResources.cError, ex.Message, ToastType.Danger));
            return;
        }

    await SignInManager.RefreshSignInAsync(user);
         Logger.LogInformation("User changed their password successfully.");

         RedirectProcessor.RedirectToCurrentPageWithStatus(PortalResources.cPasswordChanged, HttpContext);
    }
 }