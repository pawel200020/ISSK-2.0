@page "/Account/Manage/ExternalLogins"

@using Authentication.Shared.ExternalLogin
@using Authentication.Shared.ExternalLogin.Entities
@using Authentication.Shared.ExternalLogin.Managers
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Resources.PortalResources
@using Users.Shared.Managers.Edit
@using Users.Shared.Managers.Read
@using Users.Shared.Models
@using Users.Shared.SignIn

@inject CurrentUserProvider UserProvider
@inject IdentityRedirectProcessor RedirectProcessor
@inject IUserMetadataGetter UserMetadataGetter
@inject IUserExternalLoginInfoGetter UserExternalLoginInfoGetter;
@inject IExternalLoginInfoGetter ExternalLoginInfoGetter;
@inject IUserExternalLoginProvidersEditor UserExternalLoginProvidersEditor;
@inject IUserAuthenticator UserAuthenticator; 

<PageTitle>@PortalResources.cManageExternalLogins</PageTitle>

<StatusMessage/>
@if (currentLogins?.Count() > 0)
{
    <h3>@PortalResources.cRegisteredLogins</h3>
    <table class="table">
        <tbody>
        @foreach (var login in currentLogins)
        {
            <tr>
                <td>@login.ProviderType</td>
                <td>
                    @if (showRemoveButton)
                    {
                        <form @formname="@($"remove-login-{login.Provider}")" @onsubmit="OnSubmitAsync" method="post">
                            <AntiforgeryToken/>
                            <div>
                                <input type="hidden" name="@nameof(LoginProvider)" value="@login.Provider"/>
                                <input type="hidden" name="@nameof(ProviderKey)" value="@login.ProviderKey"/>
                                <button type="submit" class="btn btn-danger" title="@string.Format(PortalResources.cRemoveExternalLoginTitle, login.ProviderType)">@PortalResources.cRemove</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        @: &nbsp;
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
@if (otherLogins?.Count > 0)
{
    <h4>@PortalResources.cAddExternalLoginService</h4>
    <hr/>
    <form class="form-horizontal" action="Account/Manage/LinkExternalLogin" method="post">
        <AntiforgeryToken/>
        <div>
            <p>
                @foreach (var provider in otherLogins)
                {
                    <button type="submit" class="btn btn-primary" name="Provider" value="@provider.Provider" title="@string.Format(PortalResources.cLoginUsingProviderTitle, provider.ProviderType)">
                        @provider.ProviderType
                    </button>
                }
            </p>
        </div>
    </form>
}

@code {
    public const string LinkLoginCallbackAction = "LinkLoginCallback";

    private ApplicationUser user = default!;
    private IEnumerable<IExternalLoginMetadata> currentLogins;
    private IList<IExternalLoginMetadata>? otherLogins;
    private bool showRemoveButton;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private string? LoginProvider { get; set; }

    [SupplyParameterFromForm] private string? ProviderKey { get; set; }

    [SupplyParameterFromQuery] private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = await UserProvider.GetRequiredUserAsync(HttpContext);
        currentLogins = await UserExternalLoginInfoGetter.GetUserExternalLoginInfos(new Guid(user.Id));
        otherLogins = (await ExternalLoginInfoGetter.GetAvailableExternalLoginProvidersAsync())
            .Where(p => currentLogins.All(ul => p.ProviderType != ul.ProviderType))
            .ToList();

        showRemoveButton = await UserMetadataGetter.HasUserLocalPasswordConfiguredAsync(new Guid(user.Id)) || currentLogins.Count() > 1;

        if (HttpMethods.IsGet(HttpContext.Request.Method) && Action == LinkLoginCallbackAction)
        {
            await OnGetLinkLoginCallbackAsync();
        }
    }

    private async Task OnSubmitAsync()
    {
        var result = await UserExternalLoginProvidersEditor.RemoveAssignedExternalLogin(new Guid(user.Id), LoginProvider!, ProviderKey!);
        if (!result)
        {
            RedirectProcessor.RedirectToCurrentPageWithStatus($"{PortalResources.cError}: {PortalResources.cExternalLoginRemoveFailed}", HttpContext);
        }

        await UserAuthenticator.RefreshAsync(new Guid(user.Id));
        RedirectProcessor.RedirectToCurrentPageWithStatus(PortalResources.cExternalLoginRemoved, HttpContext);
    }

    private async Task OnGetLinkLoginCallbackAsync()
    {
        var (externalInfo, result) = await UserExternalLoginProvidersEditor.AddAssignedExternalLogin(new Guid(user.Id));
        if (!externalInfo)
        {
            RedirectProcessor.RedirectToCurrentPageWithStatus($"{PortalResources.cError}: {PortalResources.cExternalLoginInfoLoadFailed}", HttpContext);
        }
        if (!result)
        {
            RedirectProcessor.RedirectToCurrentPageWithStatus($"{PortalResources.cError}: {PortalResources.cExternalLoginAddFailed}", HttpContext);
        }

        // Clear the existing external cookie to ensure a clean login process
        await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);

        RedirectProcessor.RedirectToCurrentPageWithStatus(PortalResources.cExternalLoginAdded, HttpContext);
    }

}
