@page "/Account/Manage/Disable2fa"

@using PortalBlazor.Toasts
@using Resources.PortalResources
@using Users.Shared.Managers.Edit


<PageTitle>@PortalResources.cDisableTwoFactorTitle</PageTitle>
<Toasts class="p-3" Messages="_messages" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight"/>
<StatusMessage/>
<h3>@PortalResources.cDisableTwoFactorTitle</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@PortalResources.cDisableTwoFactorOnly</strong>
    </p>
    <p>
        @(PortalResources.cDisableTwoFactorDescription)
    </p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken/>
        <button class="btn btn-danger" type="submit">@PortalResources.cDisableTwoFactorButton</button>
    </form>
</div>

@code {
    private Guid _user;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Inject] IUserMetadataEditor UserMetadataEditor { get; set; } = null!;
    [Inject] CurrentUserProvider UserProvider { get; set; } = null!;
    [Inject] IdentityRedirectProcessor RedirectProcessor { get; set; } = null!;
    [Inject] private ToastMessageCreationService ToastMessageCreationService { get; set; } = null!;
    private readonly List<ToastMessage> _messages = new();

    protected override void OnInitialized()
    {
        _user = UserProvider.GetRequiredUserGuid(HttpContext!);
    }

    private async Task OnSubmitAsync()
    {
        try
        {
            var result = await UserMetadataEditor.Disable2FaAuthentication(_user);
            if (!string.IsNullOrEmpty(result))
            {
                _messages.Add(ToastMessageCreationService.CreateToastMessage(PortalResources.cError, result, ToastType.Warning));
                return;
            }

            RedirectProcessor.RedirectToWithStatus(
                "Account/Manage/TwoFactorAuthentication",
                PortalResources.cDisableTwoFactorSuccessMessage,
                HttpContext!);
        }
        catch (Exception ex)
        {
            _messages.Add(ToastMessageCreationService.CreateToastMessage(PortalResources.cError, ex.Message, ToastType.Danger));
        }
    }

}