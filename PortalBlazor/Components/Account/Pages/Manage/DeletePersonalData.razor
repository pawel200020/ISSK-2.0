@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using System.Runtime.InteropServices
@using Microsoft.AspNetCore.Identity
@using PortalBlazor.Toasts
@using Resources.PortalResources
@using Users.Core
@using Users.Shared.Managers.Edit
@using Users.Shared.Models


@inject SignInManager<ApplicationUser> SignInManager
@inject CurrentUserProvider UserProvider
@inject IdentityRedirectProcessor RedirectProcessor
@inject ILogger<DeletePersonalData> Logger
<PageTitle>@PortalResources.cDeletePersonalDataTitle</PageTitle>
<Toasts class="p-3" Messages="_messages" AutoHide="true" Delay="6000" Placement="ToastsPlacement.TopRight"/>
<StatusMessage Message="@message" />

<h3>@PortalResources.cDeletePersonalDataTitle</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@PortalResources.cDeletePersonalDataWarning</strong>
    </p>
    </div>

<div>
    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator/>
        <ValidationSummary class="text-danger" role="alert"/>

        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password"
                       aria-required="true" placeholder="@PortalResources.cPasswordPlaceholder" />
            <label for="password" class="form-label">@PortalResources.cPassword</label>
            <ValidationMessage For="() => Input.Password" class="text-danger"/>
        </div>
        <button class="w-100 btn btn-lg btn-danger" type="submit">@PortalResources.cDeletePersonalDataButton</button>
    </EditForm>
</div>

@code {
    private string? message;
    private Guid userGuid = default!;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [Inject] IUsersRemover UsersRemover { get; set; } = null!;
    [Inject] private ToastMessageCreationService ToastMessageCreationService { get; set; } = null!;
    private readonly List<ToastMessage> _messages = new();

    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        Input ??= new();
        userGuid = UserProvider.GetRequiredUserGuid(HttpContext);
    }

    private async Task OnValidSubmitAsync()
    {
        try
        {
            message = await UsersRemover.DeleteUserWithPasswordCheck(userGuid, Input.Password);
            if (!string.IsNullOrEmpty(message))
                return;
            
            await SignInManager.SignOutAsync();
            Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userGuid);
            RedirectProcessor.RedirectToCurrentPage();

        }
        catch (Exception ex)
        {
            _messages.Add(ToastMessageCreationService.CreateToastMessage(PortalResources.cError, ex.Message, ToastType.Danger));
        }
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)] public string Password { get; set; } = "";
    }

}