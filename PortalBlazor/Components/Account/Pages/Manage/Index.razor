@page "/Account/Manage"
@using Resources.PortalResources
@using Users.Shared.Managers.Read
@using ViewModels.RazorPages.Users

@inject CurrentUserProvider UserProvider
@inject IdentityRedirectProcessor RedirectProcessor
@inject IUserMetadataGetter IUserMetadataGetter

<PageTitle>@PortalResources.cProfile</PageTitle>

<h3>@PortalResources.cProfile</h3>
<StatusMessage/>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator/>
            <div class="form-floating mb-3">
                <input type="text" value="@username" class="form-control" placeholder="Please choose your username." disabled/>
                <label for="username" class="form-label">@PortalResources.cUserName</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number."/>
                <label for="phone-number" class="form-label">@PortalResources.cPhone</label>
                <ValidationMessage For="() => Input.PhoneNumber" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <DateInput TValue="DateOnly?" @bind-Value="Input.BirthDate" class="form-control" placeholder="Please enter your birth date."/>
                <label for="birth-date" class="form-label">@PortalResources.cBirthDate</label>
                <ValidationMessage For="() => Input.BirthDate" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@PortalResources.cSave</button>
        </EditForm>
    </div>
</div>

@code {
    private string? username;
    private string? phoneNumber;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private UserOwnEditorViewModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        
        var userFromRequest = await UserProvider.GetRequiredUserAsync(HttpContext);
        var userMetadata = await IUserMetadataGetter.GetUserMetadataAsync(new Guid(userFromRequest.Id));
        username = userMetadata.UserName;
        phoneNumber = userMetadata.PhoneNumber;

        Input.PhoneNumber ??= phoneNumber;
        Input.BirthDate ??= userFromRequest.BirthDate;

    }

    private async Task OnValidSubmitAsync()
    {
        //user.PhoneNumber = Input.PhoneNumber;
        //user.BirthDate = Input.BirthDate.Value;
        //var updateResult = await UserManager.UpdateAsync(user);
        //if (!updateResult.Succeeded)
        {
            RedirectProcessor.RedirectToCurrentPageWithStatus("Error: Failed to update a user.", HttpContext);
        }

        if (Input.PhoneNumber != phoneNumber)
        {
            //var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            //if (!setPhoneResult.Succeeded)
            {
                RedirectProcessor.RedirectToCurrentPageWithStatus("Error: Failed to set phone number.", HttpContext);
            }
        }

        //await SignInManager.RefreshSignInAsync(user);
        RedirectProcessor.RedirectToCurrentPageWithStatus("Your profile has been updated", HttpContext);
    }

}