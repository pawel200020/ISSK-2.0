@page "/Account/Manage/PersonalData"

@using Resources.PortalResources

@inject CurrentUserProvider UserProvider

<PageTitle>@PortalResources.cPersonalData</PageTitle>

<StatusMessage/>
<h3>@PortalResources.cPersonalData</h3>

<div class="row">
    <div class="col-md-6">
        <p>@PortalResources.cPersonalDataDescription</p>
        <p>
            <strong>@PortalResources.cDeletePersonalDataWarning</strong>
        </p>
        <div class="d-flex justify-content-between align-items-center gap-3">
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken/>
                <button class="btn btn-primary" type="submit">@PortalResources.cDownload</button>
            </form>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@PortalResources.cDelete</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserProvider.GetRequiredUserAsync(HttpContext);
    }

}
