@page "/Account/ExternalLogin"
@using Authentication.Shared.ExternalLogin
@using Authentication.Shared.ExternalLogin.Entities
@using Authentication.Shared.ExternalLogin.UserProfile
@using Resources.PortalResources
@using Users.Shared.Authentication
@using Users.Shared.ExternalLogin.Authenticator
@using Users.Shared.Managers.Edit
@using Users.Shared.Models
@using Users.Shared.Models.Roles
@using Users.Shared.SignIn
@using ViewModels.RazorPages.Users

@inject IUserAuthenticator UserAuthenticator
@inject IdentityRedirectProcessor RedirectProcessor
@inject ILogger<ExternalLogin> Logger
@inject IExternalLoginInfoGetter ExternalLoginInfoGetter;
@inject IExternalUserAuthenticator ExternalUserAuthenticator;
@inject IExternalUserProfileGetterFactory ExternalUserProfileGetterFactory;
@inject IUsersCreator UsersCreator;

<PageTitle>@PortalResources.cRegister</PageTitle>

<StatusMessage Message="@message"/>
<h1>@PortalResources.cRegister</h1>
<hr/>

<Alert Color="AlertColor.Success" Dismissable="true">
    <Icon Name="IconName.CheckCircleFill" class="me-2"/> @PortalResources.cExternalRegisterSucces </Alert>

<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="confirmation" method="post">
            @* <ValidationSummary class="text-danger" role="alert"/> *@
            <DataAnnotationsValidator/>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="email" aria-required="true"
                           placeholder="name@example.com"/>
                <label for="email">@PortalResources.cEmail</label>
                <ValidationMessage For="() => Input.Email" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.FirstName" class="form-control" autocomplete="firstName"
                           aria-required="true" placeholder="first name..."/>
                <label for="firstName">@PortalResources.cFirstName</label>
                <ValidationMessage For="() => Input.FirstName" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.LastName" class="form-control" autocomplete="lastName"
                           aria-required="true" placeholder="last name..."/>
                <label for="lastName">@PortalResources.cLastName</label>
                <ValidationMessage For="() => Input.LastName" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PhoneNumber" class="form-control" autocomplete="phoneNumber"
                           aria-required="true" placeholder="phone number"/>
                <label for="phoneNumber">@PortalResources.cPhone</label>
                <ValidationMessage For="() => Input.PhoneNumber" class="text-danger"/>
            </div>
            <div class="form-floating mb-3">
                <InputDate TValue="DateOnly?" @bind-Value="Input.BirthDate" class="form-control" autocomplete="date"
                           aria-required="true" placeholder="date"/>
                <label for="date">@PortalResources.cBirthDate</label>
                <ValidationMessage For="() => Input.BirthDate" class="text-danger"/>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@PortalResources.cRegister</button>
        </EditForm>
    </div>
</div>

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private string? message;
    private IExternalLoginMetadata _externalLoginInfo = default!;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private UserViewModel Input { get; set; } = new();

    [SupplyParameterFromQuery] private string? RemoteError { get; set; }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery] private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectProcessor.RedirectToWithStatus("Account/Login", $"Error from external provider: {RemoteError}", HttpContext);
        }

        var info = await ExternalLoginInfoGetter.GetExternalLoginInfoMetadata();
        if (info is null)
        {
            RedirectProcessor.RedirectToWithStatus("Account/Login", "Error loading external login information.", HttpContext);
        }

        _externalLoginInfo = info;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }
            
            RedirectProcessor.RedirectTo("Account/Login");
        }
    }

    private async Task OnLoginCallbackAsync()
    {
        var result = await ExternalUserAuthenticator.AuthenticateAsync(
            _externalLoginInfo.Provider,
            _externalLoginInfo.ProviderKey);

        if (result == AuthenticationResult.Success)
        {
            Logger.LogInformation(
                "{Name} logged in with {LoginProvider} provider.",
                _externalLoginInfo.UserName,
                _externalLoginInfo.Provider);
            RedirectProcessor.RedirectTo(ReturnUrl);
        }
        else if (result == AuthenticationResult.LockedOut)
            RedirectProcessor.RedirectTo("Account/Lockout");

        var userInfoGetter = ExternalUserProfileGetterFactory.GetUserProfileGetter(_externalLoginInfo.ProviderType);
        var userProfile = await userInfoGetter.GetProfileAsync(_externalLoginInfo.Provider, _externalLoginInfo.AccessToken);

        if (userProfile != null)
        {
            Input.Email = userProfile.Email ?? "";
            Input.FirstName = userProfile.FirstName ?? "";
            Input.LastName = userProfile.LastName ?? "";
            Input.PhoneNumber = userProfile.PhoneNumber ?? "";
            Input.BirthDate = userProfile.BirthDate ?? new DateOnly();
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var result = await UsersCreator.RegisterExternalUser(new AppUser()
        {
            Email = Input.Email,
            UserName = Input.Email,
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            PhoneNumber = Input.PhoneNumber,
            BirthDate = Input.BirthDate.Value,
            RoleId = UserRolesWithGuids.RolesWithGuids.Single(x=>x.Value == UserRole.Basic).Key
        }, ReturnUrl);
        
        await UserAuthenticator.ExternalAuthenticateAsync(new Guid(result.UserId), _externalLoginInfo.Provider);
        RedirectProcessor.RedirectTo(ReturnUrl);
    }
}