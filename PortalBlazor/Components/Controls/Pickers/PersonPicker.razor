@using System.Linq.Expressions
@using ViewModels.RazorPages.Users

<div >
    <Autocomplete SearchMethod="SearchPeople"
                  TValue="UserMetadataViewModel"
                  TItem="UserMetadataViewModel"
                  Value="Value"
                  ValueChanged="OnValueChanged"
                  ValueExpression="ValueExpression"
                  EnableDropDown="true"
                  MaximumSuggestions="5">
        
        <SelectedTemplate Context="user">
            @user.FirstName
        </SelectedTemplate>
        <ResultTemplate Context="user">
            @user.FirstName @user.LastName (@user.Email)
        </ResultTemplate>
    </Autocomplete>
</div>
@code {

    [Parameter]
    public required UserMetadataViewModel? Value { get; set; }

    [Parameter]
    public EventCallback<UserMetadataViewModel?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<UserMetadataViewModel?>>? ValueExpression { get; set; }
    

    private async Task OnValueChanged(UserMetadataViewModel? newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

    private async Task<IEnumerable<UserMetadataViewModel>> SearchPeople(string text)
    {
        return await Task.FromResult<UserMetadataViewModel []>([new UserMetadataViewModel { FirstName = "Maciej", LastName = "Kowalski", Email = "maciej.kowalski@example.com", Id = "1" }, new UserMetadataViewModel { FirstName = "Mikołaj", LastName = "Nowak", Email = "mikolaj.nowak@example.com", Id = "2" }]);
    }
}