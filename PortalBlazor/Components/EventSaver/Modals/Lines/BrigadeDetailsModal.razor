@using PortalBlazor.Components.Controls.Pickers
@using Resources.PortalResources
@using ViewModels.RazorPages.EventSaver.Lines.Brigades
<EditForm EditContext="@_editContext">
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">Guid:</label>
        <div class="col-md-7">
            <TextInput @bind-Value="Brigade.Id" Disabled="true"/>
        </div>
    </div>
    
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cPeople:</label>
        <div class="col-md-7">
            <PeoplePicker @bind-Value="Brigade.People"/> 
        </div>
    </div>
    
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cBrigadeManager:</label>
        <div class="col-md-7">
            <PersonPicker @bind-Value="Brigade.Coordinator"/> 
        </div>
    </div>
    
</EditForm>
@code {
    private EditContext? _editContext;
    [Parameter] public BrigadeViewModel Brigade { get; set; } = new BrigadeViewModel { Id = Guid.NewGuid().ToString(), };

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Brigade);
        base.OnInitialized();
    }
}