@using PortalBlazor.Components.Controls.Pickers
@using Resources.PortalResources
@using ViewModels.RazorPages.EventSaver.Lines
@using ModalSize = BlazorBootstrap.ModalSize



<Modal @ref="_modal" IsScrollable="true" Size="ModalSize.Regular" Style="backdrop-filter: brightness(60%)"/>

<EditForm EditContext="@_editContext" OnValidSubmit="HandleOnSubmit">
    <DataAnnotationsValidator/>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">Guid:</label>
        <div class="col-md-7">
            <TextInput @bind-Value="Line.Id" Disabled="true"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cLineNumber: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="Line.Number"/>
            <ValidationMessage For="@(() => Line.Number)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cOperationDay: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <DateInput TValue="DateOnly?" @bind-Value="Line.Date"/>
            <ValidationMessage For="@(() => Line.Date)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cVehicle: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput TValue="DateOnly?" @bind-Value="Line.Vehicle"/>
            <ValidationMessage For="@(() => Line.Vehicle)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cLineType: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <InputSelect TValue="LineType" class="form-select" @bind-Value="Line.LineType">
                <option value="@LineType.Tram">@PortalResources.cTram</option>
                <option value="@LineType.Bus">@PortalResources.cBus</option>
                <option value="@LineType.Trolleybus">@PortalResources.cTrolleybus</option>
                <option value="@LineType.Train">@PortalResources.cTrain</option>
            </InputSelect>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cSeasonCaption: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <SeasonPicker @bind-Value="Line.Season"/>
            <ValidationMessage For="@(() => Line.Season)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cCoordinator: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <PeoplePicker @bind-Value="Line.Supervisor"></PeoplePicker>
            <ValidationMessage For="@(() => Line.Supervisor)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@PortalResources.cIsActiveAssignment: </label>
        <div class="col-md-7">
            <CheckboxInput @bind-Value="Line.IsActive"/>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 text-end mb-2">
            <Button Type="ButtonType.Button" Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="AddBrigade">
                <Icon Name="IconName.Plus"></Icon>
            </Button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <table class="table table-sm table-striped">
                <thead>
                <tr>
                    <th>@PortalResources.cNameTitle</th>
                    <th>@PortalResources.cStart</th>
                    <th>@PortalResources.cEnd</th>
                    <th>@PortalResources.cPoints</th>
                    @* <th>@PortalResources.cPeople</th> *@
                    @* <th>Koordynator</th> *@
                    <th>@PortalResources.cCapacity</th>
                    <th>@PortalResources.cVehicle</th>
                    <th>Aktywna</th>
                    <th class="text-end">
                        <Button Type="ButtonType.Button" Color="ButtonColor.Primary" Size="ButtonSize.Small"
                                @onclick="AddBrigade">
                            <Icon Name="IconName.Plus"></Icon>
                        </Button>
                    </th>
                </tr>
                </thead>
                <tbody>
                @if (Line.Brigades != null && Line.Brigades.Count > 0)
                {
                    @foreach (var brigade in Line.Brigades)
                    {
                        <tr>
                            <td>
                                <InputText class="form-control form-control-sm" @bind-Value="brigade.Name"/>
                            </td>
                            <td>
                                <TimeInput type="time" class="form-control form-control-sm"
                                           @bind-Value="brigade.StartHour"/>
                            </td>
                            <td>
                                <TimeInput type="time" class="form-control form-control-sm"
                                           @bind-Value="brigade.EndHour"/>
                            </td>
                            <td>
                                <InputNumber class="form-control form-control-sm" style="width: 50px" @bind-Value="brigade.Points"/>
                            </td>
                            @* <td class ="people-picker"> *@
                            @*     <PeoplePicker @bind-Value="brigade.People"/> *@
                            @* </td> *@
                            @* <td class="people-picker"> *@
                            @*     <PersonPicker @bind-Value="brigade.Coordinator"/> *@
                            @* </td> *@
                            <td>
                                <InputNumber class="form-control form-control-sm" style="width: 50px" @bind-Value="brigade.Capacity"/>
                            </td>
                            <td>
                                <InputText class="form-control form-control-sm" @bind-Value="brigade.Vehicle"/>
                            </td>
                            <td class="text-center align-middle" style="width:80px;">
                                <input type="checkbox" class="form-check-input" @bind="brigade.IsActive" />
                            </td>
                            <td>
                                <Button Color="ButtonColor.Info" Size="ButtonSize.Small"
                                        @onclick="@(async () => await EditDetails(brigade))">
                                    <Icon Name="IconName.PencilSquare"></Icon>
                                </Button>
                            </td>
                            <td>
                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                        @onclick="@(async () => await RemoveBrigade(brigade))">
                                    <Icon Name="IconName.Trash"></Icon>
                                </Button>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 text-right">
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success"
                    Class="float-end me-2">@PortalResources.cSave</Button>
            <Button Type="ButtonType.Button" Color="ButtonColor.Danger" Class="float-end me-2"
                    @onclick="Close">@PortalResources.cCancel</Button>
        </div>
    </div>

</EditForm>