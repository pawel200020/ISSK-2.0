@using Abstract.Users
@using Users.Models
@using ViewModels.RazorPages.Users
<EditForm EditContext="@_editContext" OnSubmit="HandleOnValidSubmit" id="my-form-ref-2">
    <DataAnnotationsValidator/>

    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">User guid: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <TextInput @bind-Value="@UserGuid" Disabled="true"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">First Name: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <TextInput @bind-Value="@User.FirstName" Placeholder="Enter first name"/>
            <ValidationMessage For="@(() => User.FirstName)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">Last Name: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <TextInput @bind-Value="@User.LastName" Placeholder="Enter last name"/>
            <ValidationMessage For="@(() => User.LastName)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">Email: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <TextInput @bind-Value="@User.Email" Placeholder="Enter email"/>
            <ValidationMessage For="@(() => User.Email)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">Phone: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <TextInput @bind-Value="@User.PhoneNumber" Placeholder="Enter phone number"/>
            <ValidationMessage For="@(() => User.PhoneNumber)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">Birth date: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <DateInput TValue="DateOnly?" @bind-Value="@User.BirthDate" Placeholder="Select birth date"/>
            <ValidationMessage For="@(() => User.BirthDate)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">Role: <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <InputSelect TValue="Guid" class="form-select" @bind-Value="@User.RoleId">
                @foreach (var (guid, role) in UserRolesWithGuids.RolesWithGuids)
                {
                    <option value="@guid">@role</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => User.RoleId)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-3 col-form-label">Is disabled:</label>
        <div class="col-md-9">
            <CheckboxInput @bind-Value="@User.IsDisabled"/>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 text-right">
            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" Class="float-end" @onclick="ResetForm">Reset</Button>
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Class="float-end me-2">Submit</Button>
            <button type="submit" class="btn btn-danger" form="my-form-ref-2">Submit Form</button>
        </div>
    </div>

</EditForm>


@code {

    private EditContext? _editContext;
    private UserAdminCreateViewModel User { get; set; } = null!;
    private string UserGuid { get; set; }

    protected override void OnInitialized()
    {
        User = new UserAdminCreateViewModel();
        _editContext = new EditContext(User);
        base.OnInitialized();
    }

    public void HandleOnValidSubmit()
    {
        // additional check
        if (_editContext.Validate())
        {
            // do something
            // submit the form
            Console.WriteLine("Form submitted successfully");
        }
    }

    private void ResetForm()
    {
        User = new UserAdminCreateViewModel();
        _editContext = new EditContext(User);
    }

}