<div class="row text-center">
    <p>@Resources.PortalResources.PortalResources.cDeleteConfirmation</p>
</div>

<div class="row text-end">
    <div class="col-md-12 text-right">
        <Button Color="ButtonColor.Danger" Class="float-end me-2" @onclick="OnDeleteClick">@Resources.PortalResources.PortalResources.cDelete</Button>
        <Button Color="ButtonColor.Secondary" Class="float-end me-2" @onclick="OnCloseClick">@Resources.PortalResources.PortalResources.cCancel</Button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnCloseClick { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnDeleteClick { get; set; }
}