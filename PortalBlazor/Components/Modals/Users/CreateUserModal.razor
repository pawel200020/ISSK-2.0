@using ViewModels.RazorPages.Users
@using Microsoft.AspNetCore.Identity
@using AutoMapper
@using global::Users.Shared.Managers.Edit
@using global::Users.Shared.Models
@using global::Users.Shared.Models.Roles

@inject IUsersCreator UsersCreator
@inject IMapper Mapper;


<EditForm EditContext="@_editContext" OnSubmit="RegisterUser">
    <DataAnnotationsValidator/>
    <Alert Show="@(!string.IsNullOrEmpty(Message))" Color="AlertColor.Danger" Dismissable="true" hidden="@string.IsNullOrEmpty(Message)"> <Icon Name="@IconName.ExclamationTriangleFill" class="me-2"></Icon> @Message </Alert>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cUserIdentity: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.Id" Disabled="true"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cName: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.FirstName"
                       Placeholder=@Resources.PortalResources.PortalResources.cAddFirstNameNt/>
            <ValidationMessage For="@(() => User.FirstName)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cLastName: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.LastName"
                       Placeholder=@Resources.PortalResources.PortalResources.cAddLastNameNt/>
            <ValidationMessage For="@(() => User.LastName)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cEmail: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.Email" Placeholder=@Resources.PortalResources.PortalResources.cAddEmailNt/>
            <ValidationMessage For="@(() => User.Email)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cUserName: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.UserName"
                       Placeholder=@Resources.PortalResources.PortalResources.cAddUserNameNt/>
            <ValidationMessage For="@(() => User.UserName)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cPhone: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.PhoneNumber"
                       Placeholder=@Resources.PortalResources.PortalResources.cAddPhoneNt/>
            <ValidationMessage For="@(() => User.PhoneNumber)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cBirthDate: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <DateInput TValue="DateOnly?" @bind-Value="@User.BirthDate"/>
            <ValidationMessage For="@(() => User.BirthDate)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cAccountType: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <InputSelect TValue="Guid" class="form-select" @bind-Value="@User.RoleId">
                @foreach (var (guid, role) in UserRolesWithGuids.RolesWithGuids)
                {
                    <option value="@guid">@role</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => User.RoleId)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cPassword: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <InputText type="password" class="form-control" @bind-Value="User.Password" autocomplete="new-password"
                       aria-required="true" placeholder=@Resources.PortalResources.PortalResources.cAddEnterPassNt/>
            <ValidationMessage For="() => User.Password" class="text-danger"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cConfirmPassword: <span
                class="text-danger">*</span></label>
        <div class="col-md-7">
            <InputText type="password" class="form-control" @bind-Value="User.ConfirmPassword"
                       autocomplete="new-password" aria-required="true"
                       placeholder=@Resources.PortalResources.PortalResources.cAddPassCfNt/>
            <ValidationMessage For="@(() => User.ConfirmPassword)" class="text-danger"/>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 text-right">
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success"
                    Class="float-end me-2">@Resources.PortalResources.PortalResources.cCreate</Button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public EventCallback<Task> OnSuccessCallback { get; set; }
    [Parameter] public EventCallback<Task> OnFailCallback { get; set; }
    private EditContext? _editContext;
    private UserAdminCreateViewModel User { get; set; } = null!;
    private IEnumerable<IdentityError>? identityErrors;
    private string? Message => identityErrors is null ? null : $" {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        PrepareNewUser();
        base.OnInitialized();
    }

    public async Task RegisterUser()
    {
        // additional check
        if (!_editContext.Validate()) return;

        var userFromRequest = (UserAdminCreateViewModel)_editContext.Model;
        var user = Mapper.Map<AppUser>(userFromRequest);

        var creationResult = await UsersCreator.RegisterUser(user, null);

        if (creationResult.Errors is not null)
        {
            identityErrors = creationResult.Errors;
            return;
        }
        
        await OnSuccessCallback.InvokeAsync();
    }

    private void PrepareNewUser()
    {
        User = new UserAdminCreateViewModel()
        {
            RoleId = UserRolesWithGuids.RolesWithGuids.Where(x => x.Value == UserRole.Basic).Select(x => x.Key).Single(),
            Id = (new Guid()).ToString()
        };
        _editContext = new EditContext(User);
    }

}