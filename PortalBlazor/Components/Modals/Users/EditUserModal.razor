@using ViewModels.RazorPages.Users
@using AutoMapper
@using global::Users.Shared.Managers.Edit
@using global::Users.Shared.Models
@using PortalBlazor.Components.Modals.ConfirmationModals
@using ModalSize = BlazorBootstrap.ModalSize
<Modal @ref="_modal" IsVerticallyCentered="true" Style="backdrop-filter: blur(10px)" Size="ModalSize.Small"/>

<EditForm EditContext="@_editContext" OnSubmit="HandleOnSubmit" id="my-form-ref-2">
    <DataAnnotationsValidator/>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cUserIdentity: </label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.Id" Disabled="true"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cName: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.FirstName" Placeholder=@Resources.PortalResources.PortalResources.cAddFirstNameNt/>
            <ValidationMessage For="@(() => User.FirstName)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cLastName: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.LastName" Placeholder=@Resources.PortalResources.PortalResources.cAddLastNameNt/>
            <ValidationMessage For="@(() => User.LastName)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cEmail: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.Email" Placeholder=@Resources.PortalResources.PortalResources.cAddEmailNt/>
            <ValidationMessage For="@(() => User.Email)"/>
        </div>
    </div>
    
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cUserName: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.UserName" Placeholder=@Resources.PortalResources.PortalResources.cAddUserNameNt/>
            <ValidationMessage For="@(() => User.UserName)"/>
        </div>
    </div>
    
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cPhone: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <TextInput @bind-Value="@User.PhoneNumber" Placeholder=@Resources.PortalResources.PortalResources.cAddPhoneNt/>
            <ValidationMessage For="@(() => User.PhoneNumber)"/>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cBirthDate: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <DateInput TValue="DateOnly?" @bind-Value="@User.BirthDate"/>
            <ValidationMessage For="@(() => User.BirthDate)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cAccountType: <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <InputSelect TValue="Guid" class="form-select" @bind-Value="@User.RoleId">
                @foreach (var (guid, role) in UserRolesWithGuids.RolesWithGuids)
                {
                    <option value="@guid">@role</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => User.RoleId)"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cIsDisabled:</label>
        <div class="col-md-7">
            <CheckboxInput @bind-Value="@User.IsAccountDisabled"/>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label class="col-md-5 col-form-label">@Resources.PortalResources.PortalResources.cIsEmailConfirmed:</label>
        <div class="col-md-7">
            <CheckboxInput @bind-Value="@User.IsEmailConfirmed" Disabled="true"/>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 text-right">
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Class="float-end me-2">@Resources.PortalResources.PortalResources.cSave</Button>
            <Button Type="ButtonType.Button" Color="ButtonColor.Danger" Class="float-end me-2" @onclick="RemoveUser">@Resources.PortalResources.PortalResources.cDelete</Button>
        </div>
    </div>
</EditForm>

@code {

    private EditContext? _editContext;
    [Parameter] public UserAdminViewModel User { get; set; } = null!;
    [Parameter] public EventCallback<Task> OnSuccessCallback { get; set; }
    [Parameter] public EventCallback<Task> OnFailCallback { get; set; }
    [Inject] private IUsersCreator UsersCreator { get; set; } = default!;
    [Inject] private IUsersEditor UsersEditor { get; set; } = default!;
    [Inject] private IUsersRemover UsersRemover { get; set; } = null!;
    [Inject] private IMapper Mapper { get; set; } = default!;
    [Parameter] public bool IsEditMode { get; set; }
    private Modal _modal = default!;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(User);
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        _editContext = new EditContext(User);
        base.OnParametersSet();
    }

    public async Task HandleOnSubmit()
    {
        if (_editContext != null && !_editContext.Validate() || _editContext is null)
        {
            await OnFailCallback.InvokeAsync();
            return;
        }

        var userFromRequest = (UserAdminViewModel)_editContext.Model;

        if (await UsersEditor.EditUserAsync(Mapper.Map<AppUser>(userFromRequest)))
            await OnSuccessCallback.InvokeAsync();
        else
            await OnFailCallback.InvokeAsync();
    }

    private async Task RemoveUser()
    {
        var parameters = new Dictionary<string, object>();
        parameters.Add("OnCloseClick", EventCallback.Factory.Create<MouseEventArgs>(this, OnCloseClick));
        parameters.Add("OnDeleteClick", EventCallback.Factory.Create<MouseEventArgs>(this, OnDeleteClick));
        await _modal.ShowAsync<ConfirmDeleteModal>(Resources.PortalResources.PortalResources.cDelete, parameters: parameters);
    }
    
    private async Task OnCloseClick(MouseEventArgs e) => await _modal.HideAsync();
    
    private async Task OnDeleteClick(MouseEventArgs e)
    {
        await _modal.HideAsync();
        if (_editContext != null && !_editContext.Validate() || _editContext is null)
        {
            await OnFailCallback.InvokeAsync();
            return;
        }

        var userFromRequest = (UserAdminViewModel)_editContext.Model;

        if (await UsersRemover.DeleteUser(new Guid(userFromRequest.Id)))
            await OnSuccessCallback.InvokeAsync();
        else
            await OnFailCallback.InvokeAsync();
    }
}